//
//  Secrets.template.xcconfig
//  Health App
//
//  Template for API keys and secrets
//  Copy this file to Secrets.xcconfig and fill in your actual values
//

// IMPORTANT: Never commit Secrets.xcconfig to version control!
// This template shows the required keys without exposing real values.

// Supabase Configuration
SUPABASE_URL = YOUR_SUPABASE_URL_HERE
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY_HERE

// Strava API Configuration
STRAVA_CLIENT_ID = YOUR_STRAVA_CLIENT_ID_HERE
STRAVA_CLIENT_SECRET = YOUR_STRAVA_CLIENT_SECRET_HERE

// USDA FoodData Central API
USDA_API_KEY = YOUR_USDA_API_KEY_HERE

// Instructions:
// 1. Copy this file: cp Secrets.template.xcconfig Secrets.xcconfig
// 2. Edit Secrets.xcconfig and replace all YOUR_*_HERE values
// 3. Never commit Secrets.xcconfig to git (it's in .gitignore)
